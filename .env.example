# Local development (default): SQLite file, no auth token needed
DATABASE_URL=file:./local.db

# Production (Turso): uncomment and fill in after `turso db create gymgraph`
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Signs session cookies and encrypts TOTP secrets. Generate with: openssl rand -base64 32
# In production set it as a Worker secret: openssl rand -base64 32 | npx wrangler secret put AUTH_SECRET
AUTH_SECRET=replace-with-a-long-random-string

# `npm run dev` signs you in automatically as a local test account. Uncomment to test the real sign-in flow:
# DEV_AUTO_LOGIN=off
